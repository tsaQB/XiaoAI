+    let lower = model.to_ascii_lowercase();
+    if lower.contains("claude") {
+        64_000
+    } else if lower.contains("gemini")
+        || ["o1", "o3", "gpt-4o", "gpt-5", "sol", "terra", "luna"]
+            .iter()
+            .any(|needle| lower.contains(needle))
+    {
+        65_536
+    } else {
+        16_384
+    }
+}
